# Backend Configuration
PROJECT_NAME=NeuraCode
SECRET_KEY=super-secret-key-change-in-production-or-generation
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default fallback to sqlite locally if PostgreSQL is not running
DATABASE_URL=sqlite:///./neuracode.db
# To connect to a real PostgreSQL instance in production, uncomment the line below:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuracode

# CORS Configuration (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Tutor Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TUTOR_RATE_LIMIT_PER_WINDOW=15
